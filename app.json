{
  "name": "VC Glich Bot",
  "description": "Telegram VC SFU IP fetcher with owner approval, MongoDB, colored buttons",
  "repository": "https://github.com/oyevipthoma88/Vc-glich-",
  "logo": "https://telegram.org/img/t_logo.png",
  "keywords": [
    "telegram",
    "telethon",
    "vc",
    "sfu",
    "mongodb"
  ],
  "stack": "heroku-22",
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "env": {
    "API_ID": {
      "description": "Telegram API ID",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API HASH",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "BotFather token",
      "required": true
    },
    "OWNER_IDS": {
      "description": "Comma-separated owner IDs",
      "required": true
    },
    "TG_SESSION": {
      "description": "Telethon StringSession (optional if using DB login)",
      "required": false
    },
    "MONGO_URI": {
      "description": "MongoDB Atlas URI (optional)",
      "required": false
    },
    "APPROVED_IDS": {
      "description": "Pre-approved IDs",
      "required": false,
      "value": ""
    },
    "TUTORIAL_URL": {
      "description": "Optional tutorial URL (empty hides button)",
      "required": false,
      "value": ""
    },
    "VIDEO_URL": {
      "description": "Optional video URL (empty hides button)",
      "required": false,
      "value": ""
    }
  },
  "success_url": "/"
}